#!/sbin/openrc-run
# Alpine's krb5kdc init script with a hard dependency on slapd: the KDC reads
# its principals from LDAP and fails if it starts first.

daemon="MIT Kerberos 5 KDC"
exec="/usr/sbin/krb5kdc"

depend() {
    need net slapd
    after slapd
}

start() {
	ebegin "Starting $daemon"
	start-stop-daemon --start --quiet --exec ${exec} 1>&2
	eend $? "Error starting $daemon"
}

stop() {
	ebegin "Stopping $daemon"
	start-stop-daemon --stop --quiet --exec ${exec} 1>&2
	eend $? "Error stopping $daemon"
}
