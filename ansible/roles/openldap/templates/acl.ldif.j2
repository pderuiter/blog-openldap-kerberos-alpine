# {{ ansible_managed }}
# Phase 3: full ACL set, now that the Kerberos and openssh-lpk schemas are loaded.
dn: olcDatabase={1}mdb,cn=config
changetype: modify
replace: olcAccess
olcAccess: {0}to attrs=userPassword by self write by anonymous auth by * none
olcAccess: {1}to attrs=krbPrincipalKey by dn.exact="{{ kerberos_services[0].dn }}" read by dn.exact="{{ kerberos_services[1].dn }}" write by self write by anonymous auth by * none
olcAccess: {2}to dn.subtree="cn=krbContainer,{{ ldap_base }}" by dn.exact="{{ kerberos_services[0].dn }}" write by dn.exact="{{ kerberos_services[1].dn }}" write by * none
olcAccess: {3}to attrs=sshPublicKey by self write by * read
olcAccess: {4}to * by dn.exact="{{ kerberos_services[1].dn }}" write by * read
